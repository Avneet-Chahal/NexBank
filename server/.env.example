# NexBank Server Configuration Template
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication Security Template
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# MongoDB Atlas Database Connection
# Replace <username>, <password>, and <cluster-host> with your MongoDB Atlas deployment values
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexbank?retryWrites=true&w=majority

# SMTP Email Notification Service (Feature 3)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="NexBank <no-reply@nexbank.com>"

